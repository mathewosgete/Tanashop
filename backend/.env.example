# Backend Environment Variables — copy this to .env and fill in your values
# This file IS committed to git. The actual .env is NOT.

PORT=5000
NODE_ENV=production

# JWT (generate a strong secret: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET=your-strong-random-jwt-secret-here

# Stripe Secret Key (from https://dashboard.stripe.com/apikeys)
STRIPE_SECRET_KEY=sk_test_...

# CORS — set to your Vercel frontend URL in production
FRONTEND_URL=https://your-app.vercel.app
