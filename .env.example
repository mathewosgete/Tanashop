# Frontend Environment Variables — copy this to .env and fill in your values

# Backend API URL for local development
# If your backend runs locally, use http://localhost:5000/api
# If you deploy later, update this to your production API endpoint.
REACT_APP_API_URL=http://localhost:5000/api

# Stripe Publishable Key (from https://dashboard.stripe.com/apikeys)
# Use a test key for development and never commit your secret key.
REACT_APP_STRIPE_KEY=pk_test_...
